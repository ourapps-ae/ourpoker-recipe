    {
      "name": "normaliseAddress",
      "description": "The address without trailing slashes when it is an absolute http or https address with no credentials, query or fragment, else null.",
      "params": [
        {
          "name": "address",
          "required": false,
          "schema": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      ],
      "result": {
        "name": "address",
        "schema": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https?://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~/-]*)?$"
        }
      },
      "tags": [
        {
          "name": "typescript"
        }
      ]
