  "components": {
    "schemas": {
      "InvitationSettings": {
        "type": "object",
        "properties": {
          "inviteAddress": {
            "type": "string",
            "description": "The application's own page: an absolute http or https address with no credentials, query or fragment.",
            "pattern": "^https?://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~/-]*)?$"
          },
          "codeLength": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "inviteAddress",
          "codeLength"
        ],
        "additionalProperties": false
      },
      "Invitation": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "codeLength characters from ABCDEFGHJKMNPQRSTUVWXYZ23456789.",
            "pattern": "^[ABCDEFGHJKMNPQRSTUVWXYZ2-9]*$"
          },
          "roomId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The room the link is for, or null for the application.",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          }
        },
        "required": [
          "code",
          "roomId"
        ],
        "additionalProperties": false
      },
      "InviteLink": {
        "type": "string",
        "description": "<inviteAddress without trailing slash>?code=<CODE>[&room=<roomId>]",
        "pattern": "^https?://[^?#]+\\?code=[ABCDEFGHJKMNPQRSTUVWXYZ2-9]+(&room=[A-Za-z0-9_-]{1,64})?$"
      },
      "ScanPayload": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "The link to encode."
          },
          "correctionLevel": {
            "type": "string",
            "enum": [
              "L",
              "M",
              "Q",
              "H"
            ],
            "description": "Always M."
          }
        },
        "required": [
          "text",
          "correctionLevel"
        ],
        "additionalProperties": false,
        "description": "What a scannable-code renderer encodes; drawing it is a platform call."
      },
      "ShareEnvironment": {
        "type": "object",
        "properties": {
          "share": {
            "description": "Function (data: { title?: string; text?: string; url: string }) => Promise<void>, the Web Share API navigator.share."
          },
          "writeText": {
            "description": "Function (text: string) => Promise<void>, navigator.clipboard.writeText."
          }
        },
        "additionalProperties": false
      },
      "ShareResult": {
        "type": "string",
        "enum": [
          "shared",
          "copied",
          "cancelled",
          "unavailable"
        ]
      }
    }
  }
