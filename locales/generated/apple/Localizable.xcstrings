    "err_badName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name must be 1 to 20 plain characters and not already taken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom doit comporter 1 à 20 caractères simples et ne pas être déjà pris."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Name muss 1 bis 20 einfache Zeichen haben und frei sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre debe tener de 1 a 20 caracteres simples y no estar ya en uso."
          }
        }
      }
    },
    "err_nameTaken": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That name is in use at this table. Choose another name, or wait: a seat left by a closed app is freed one minute after it closed while the table waits, or when the game ends."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce nom est déjà utilisé à cette table. Choisissez-en un autre, ou attendez : une place laissée par une appli fermée se libère une minute après sa fermeture tant que la table attend, ou à la fin de la partie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Name wird an diesem Tisch schon verwendet. Wähle einen anderen oder warte: Ein Platz, den eine geschlossene App hinterlässt, wird eine Minute nach dem Schließen frei, solange der Tisch wartet, oder am Ende des Spiels."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese nombre ya se usa en esta mesa. Elige otro o espera: un asiento que deja una app cerrada se libera un minuto después de cerrarla mientras la mesa espera, o al terminar la partida."
          }
        }
      }
    },
