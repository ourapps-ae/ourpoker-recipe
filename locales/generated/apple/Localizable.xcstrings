    "tut_lobby_room": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everyone listed here plays the next game together."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous ceux de la liste jouent ensemble la prochaine partie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle hier Aufgeführten spielen das nächste Spiel zusammen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los de la lista juegan juntos la próxima partida."
          }
        }
      }
    },
    "tut_lobby_bots": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a computer player with the robot button."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un joueur ordinateur avec le bouton robot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge mit dem Roboterknopf einen Computerspieler hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un jugador de ordenador con el botón del robot."
          }
        }
      }
    },
    "tut_lobby_start": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone can press play to start the game once two players are here."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dès que deux joueurs sont là, n'importe qui peut appuyer sur lecture pour lancer la partie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald zwei Spieler da sind, kann jeder auf Start drücken, um das Spiel zu beginnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando haya dos jugadores, cualquiera puede pulsar el botón de inicio para empezar la partida."
          }
        }
      }
    },
    "tut_lobby_exit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The arrow on the left takes you out. When the last person leaves, the room is cleared, computer players too."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La flèche à gauche vous fait sortir. Quand la dernière personne part, la salle est vidée, joueurs ordinateur compris."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Pfeil links bringt dich hinaus. Wenn die letzte Person geht, wird der Raum geleert, Computerspieler eingeschlossen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La flecha de la izquierda te saca de la sala. Cuando se va la última persona, la sala se vacía, también los jugadores de ordenador."
          }
        }
      }
    },
    "tut_bots_t": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer players"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joueurs ordinateur"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Computerspieler"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Jugadores de ordenador"
          }
        }
      }
    },
    "tut_bots_mark": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A robot marks a computer player."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un robot signale un joueur ordinateur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Roboter kennzeichnet einen Computerspieler."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un robot señala a un jugador de ordenador."
          }
        }
      }
    },
    "tut_bots_remove": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the minus beside one to remove it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le moins à côté de l'un d'eux pour le retirer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf das Minus daneben, um ihn zu entfernen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el signo menos a su lado para quitarlo."
          }
        }
      }
    },
    "tut_table_t": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The table"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La table"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tisch"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mesa"
          }
        }
      }
    },
    "tut_table_board": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The middle row holds the community cards, shared by everyone. Each place is underlined gold."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La rangée du milieu reçoit les cartes communes, partagées par tous. Chaque place est soulignée d'or."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der mittleren Reihe liegen die Gemeinschaftskarten, die allen gehören. Jeder Platz ist golden unterstrichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fila del centro tiene las cartas comunitarias, compartidas por todos. Cada lugar está subrayado en dorado."
          }
        }
      }
    },
    "tut_table_pot": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pot ring collects the chips bet in each round. The winner of the hand takes it all."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cercle du pot reçoit les jetons misés à chaque tour. Le gagnant de la main remporte tout."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Potkreis sammeln sich die Chips jeder Setzrunde. Der Gewinner der Hand bekommt alles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El círculo del bote recoge las fichas apostadas en cada ronda. El ganador de la mano se lo lleva todo."
          }
        }
      }
    },
    "tut_table_level": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Above the prompt: the level, the blinds and the time until they rise."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au-dessus du message : le niveau, les blindes et le temps avant qu'elles montent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über der Ansage: die Stufe, die Blinds und die Zeit, bis sie steigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encima del mensaje: el nivel, las ciegas y el tiempo hasta que suban."
          }
        }
      }
    },
    "tut_cards_t": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your cards and chips"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos cartes et vos jetons"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Karten und Chips"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus cartas y fichas"
          }
        }
      }
    },
    "tut_cards_hand": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your two cards are underlined green. When it is your turn they glow: double tap them to check, flick them up to fold."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos deux cartes sont soulignées de vert. Quand c'est votre tour, elles brillent : touchez-les deux fois pour parler, lancez-les vers le haut pour vous coucher."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine zwei Karten sind grün unterstrichen. Bist du dran, leuchten sie: zweimal tippen zum Schieben, nach oben wischen zum Passen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus dos cartas están subrayadas en verde. Cuando es tu turno brillan: tócalas dos veces para pasar, deslízalas hacia arriba para retirarte."
          }
        }
      }
    },
    "tut_cards_stack": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap your chips to bet or raise; tap Call to match the bet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez vos jetons pour miser ou relancer ; touchez Suivre pour égaler la mise."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf deine Chips, um zu setzen oder zu erhöhen; tippe auf Mitgehen, um den Einsatz zu halten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca tus fichas para apostar o subir; toca Igualar para igualar la apuesta."
          }
        }
      }
    },
    "tut_cards_zoom": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap any cards to see them large; tap again to put them away."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez des cartes pour les voir en grand ; touchez encore pour les ranger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf Karten, um sie groß zu sehen; tippe erneut, um sie wegzulegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca cualquier carta para verla en grande; vuelve a tocar para guardarla."
          }
        }
      }
    },
    "tut_odds_list": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Under the table: the hands your cards can still make, most likely first, with the chance of each."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sous la table : les mains que vos cartes peuvent encore faire, la plus probable d'abord, avec la chance de chacune."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter dem Tisch: die Blätter, die deine Karten noch ergeben können, das wahrscheinlichste zuerst, mit der Chance für jedes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Debajo de la mesa: las manos que tus cartas aún pueden formar, la más probable primero, con la probabilidad de cada una."
          }
        }
      }
    },
    "tut_odds_box": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cards that make a hand sit in a dotted box; the cards after it only settle ties."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cartes qui forment une main sont dans un cadre pointillé ; celles d'après ne servent qu'à départager."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Karten, die ein Blatt bilden, stehen in einem gepunkteten Rahmen; die Karten danach entscheiden nur bei Gleichstand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cartas que forman una mano van en un recuadro punteado; las de después solo deshacen empates."
          }
        }
      }
    },
    "tut_odds_colours": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Underlines show where each card comes from: green your hand, gold the community cards, red still to come."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les soulignements montrent d'où vient chaque carte : vert votre main, or les cartes communes, rouge encore à venir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Unterstriche zeigen, woher jede Karte kommt: grün deine Hand, gold die Gemeinschaftskarten, rot noch ausstehend."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los subrayados muestran de dónde viene cada carta: verde tu mano, dorado las comunitarias, rojo las que faltan."
          }
        }
      }
    },
    "tut_odds_rank": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "#1 is the best hand there is, a royal flush; every hand beats all the hands ranked below it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "#1 est la meilleure main possible, la quinte flush royale ; chaque main bat toutes celles classées en dessous."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "#1 ist das beste Blatt überhaupt, ein Royal Flush; jedes Blatt schlägt alle, die unter ihm stehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El #1 es la mejor mano posible, la escalera real; cada mano gana a todas las que están por debajo."
          }
        }
      }
    },
    "tut_ev_blinds_t": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The blinds"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les blindes"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Blinds"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ciegas"
          }
        }
      }
    },
    "tut_ev_blinds": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every hand starts with two forced bets: the small blind and the big blind, twice as much. They move one seat round the table each hand and rise with each level."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque main commence par deux mises forcées : la petite blinde et la grosse blinde, deux fois plus. Elles avancent d'une place à chaque main et montent à chaque niveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Hand beginnt mit zwei Pflichteinsätzen: dem Small Blind und dem doppelt so hohen Big Blind. Sie wandern jede Hand einen Platz weiter und steigen mit jeder Stufe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada mano empieza con dos apuestas obligadas: la ciega pequeña y la ciega grande, el doble. Avanzan un asiento en cada mano y suben con cada nivel."
          }
        }
      }
    },
    "tut_ev_call_t": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calling"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivre"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitgehen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Igualar"
          }
        }
      }
    },
    "tut_ev_call": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To call is to put in as much as the highest bet so far, to stay in the hand."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivre, c'est mettre autant que la plus grosse mise du tour, pour rester dans la main."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitgehen heißt, so viel zu setzen wie der höchste Einsatz bisher, um in der Hand zu bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Igualar es poner tanto como la apuesta más alta hasta ahora, para seguir en la mano."
          }
        }
      }
    },
    "tut_ev_bet_t": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Betting and raising"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miser et relancer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzen und Erhöhen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apostar y subir"
          }
        }
      }
    },
    "tut_ev_bet": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bet puts in chips that everyone else must match to stay in; a raise makes the bet bigger."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une mise engage des jetons que les autres doivent égaler pour rester ; une relance augmente la mise."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Einsatz bringt Chips ins Spiel, die alle anderen halten müssen, um dabeizubleiben; eine Erhöhung macht den Einsatz größer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una apuesta pone fichas que los demás deben igualar para seguir; una subida hace la apuesta mayor."
          }
        }
      }
    },
    "tut_ev_pot_t": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pot"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pot"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Pot"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El bote"
          }
        }
      }
    },
    "tut_ev_pot": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a round of betting ends, the bets go into the pot. The best hand at the end, or the last player left, takes it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À la fin d'un tour d'enchères, les mises vont au pot. La meilleure main à la fin, ou le dernier joueur restant, le remporte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am Ende einer Setzrunde kommen die Einsätze in den Pot. Das beste Blatt am Schluss, oder der letzte verbliebene Spieler, gewinnt ihn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando termina una ronda de apuestas, las apuestas van al bote. Se lo lleva la mejor mano al final, o el último jugador que quede."
          }
        }
      }
    },
    "tut_ev_flop_t": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The flop"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le flop"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Flop"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El flop"
          }
        }
      }
    },
    "tut_ev_flop": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three community cards are turned up together: the flop. Another round of betting follows."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trois cartes communes sont retournées ensemble : le flop. Un autre tour d'enchères suit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drei Gemeinschaftskarten werden zusammen aufgedeckt: der Flop. Danach folgt eine weitere Setzrunde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se descubren tres cartas comunitarias a la vez: el flop. Sigue otra ronda de apuestas."
          }
        }
      }
    },
    "tut_ev_turn_t": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The turn"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le turn"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Turn"
