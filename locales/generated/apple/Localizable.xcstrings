    "viewer_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The table viewer lies in the middle of the table and shows the game to everyone round it. It takes no seat and shows nobody's hidden cards; each player plays on their own phone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'écran de table se pose au milieu de la table et montre la partie à tous ceux qui sont autour. Il ne prend pas de place et ne montre les cartes cachées de personne ; chacun joue sur son téléphone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tischanzeige liegt in der Mitte des Tisches und zeigt allen ringsum das Spiel. Sie belegt keinen Platz und zeigt niemandes verdeckte Karten; jeder spielt auf seinem eigenen Telefon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pantalla de mesa se coloca en el centro de la mesa y muestra la partida a todos los que están alrededor. No ocupa sitio ni enseña las cartas ocultas de nadie; cada jugador juega en su propio teléfono."
          }
        }
      }
    },
