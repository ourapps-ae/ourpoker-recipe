    "update_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have %1$@. Install the new version to keep playing with everyone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez la %1$@. Installez la nouvelle version pour continuer à jouer avec tout le monde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast %1$@. Installiere die neue Version, um mit allen weiterzuspielen."
          }
        },
