    "tut_remote_cards": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the buttons to fold, check or call. Choose an amount, then confirm your bet. Select a card to reveal it when allowed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez les boutons pour vous coucher, checker ou suivre. Choisissez un montant, puis confirmez la mise. Sélectionnez une carte pour la montrer lorsque cela est permis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze die Tasten zum Passen, Schieben oder Mitgehen. Wähle einen Betrag und bestätige den Einsatz. Wähle eine Karte, um sie zu zeigen, wenn dies erlaubt ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa los botones para retirarte, pasar o igualar. Elige un importe y confirma la apuesta. Selecciona una carta para mostrarla cuando esté permitido."
          }
        }
      }
    },
    "tut_remote_zoom": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose View cards or On the table to enlarge cards. Choose Done to close them."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez Voir les cartes ou Sur la table pour agrandir les cartes. Choisissez Terminé pour les fermer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle Karten ansehen oder Auf dem Tisch, um Karten zu vergrößern. Wähle Fertig, um sie zu schließen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige Ver las cartas o En la mesa para ampliar las cartas. Elige Listo para cerrarlas."
          }
        }
      }
    },
