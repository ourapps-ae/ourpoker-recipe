          }
        }
      }
    },
    "tut_home_rooms": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each room is a poker table: Casino and Home. Up to nine players sit at one, friends and computer players."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque salle est une table de poker : Casino et Maison. Jusqu'à neuf joueurs s'y assoient, amis et joueurs ordinateur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Raum ist ein Pokertisch: Casino und Zuhause. Bis zu neun Spieler sitzen daran, Freunde und Computerspieler."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada sala es una mesa de póquer: Casino y Casa. Se sientan hasta nueve jugadores, amigos y jugadores de ordenador."
          }
        }
      }
    },
    "tut_home_preview": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a room to select it and see what it looks like."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez une salle pour la choisir et voir à quoi elle ressemble."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf einen Raum, um ihn auszuwählen und zu sehen, wie er aussieht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una sala para elegirla y ver cómo es."
          }
        }
      }
    },
    "tut_home_enter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the arrow to sit down in the selected room. If a game is already on there, you watch it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez la flèche pour vous asseoir dans la salle choisie. Si une partie y est en cours, vous la regardez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf den Pfeil, um dich in den gewählten Raum zu setzen. Läuft dort schon ein Spiel, schaust du zu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca la flecha para sentarte en la sala elegida. Si ya hay una partida, la miras."
          }
        }
      }
    },
    "tut_home_name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the pencil to change the name the others see."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le crayon pour changer le nom que voient les autres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf den Stift, um den Namen zu ändern, den die anderen sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el lápiz para cambiar el nombre que ven los demás."
          }
        }
      }
    },
    "tut_lobby_t": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
