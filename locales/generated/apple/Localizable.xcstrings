    "help_idea_t": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The idea"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le principe"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Idee"
          }
        },
        "es": {
