          "stringUnit": {
            "state": "translated",
            "value": "Your seat is gone. The table was reset or you were away too long."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre place a disparu. La table a été réinitialisée ou vous êtes resté absent trop longtemps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Platz ist weg. Der Tisch wurde zurückgesetzt oder du warst zu lange fort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu asiento ha desaparecido. La mesa se reinició o estuviste fuera demasiado tiempo."
          }
        }
      }
    },
