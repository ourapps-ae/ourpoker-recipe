{
  "name": "{{applicationId}}-desktop",
  "version": "1.0.0",
  "description": "Bundled desktop player and board",
  "private": true,
  "main": "src/main.cjs",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "build": "node scripts/build.cjs",
    "check": "node --test test/*.test.cjs",
    "start": "electron .",
    "package:win": "npm run build && node scripts/package.cjs"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
