  "jobs": [
    {
      "id": "server",
      "overrideQuestion": "server",
      "candidates": [
        {
          "component": "ourapps-ae/server-host",
          "profile": "cloudflare-free"
        },
        {
          "component": "ourapps-ae/server-host",
          "profile": "cloudflare-paid"
        },
        {
          "component": "ourapps-ae/server-host",
          "profile": "own-hardware"
        }
      ]
    },
    {
      "id": "realtime",
      "overrideQuestion": "server",
      "candidates": [
        {
          "component": "ourapps-ae/realtime-rooms",
          "profile": "free"
        },
        {
          "component": "ourapps-ae/realtime-rooms",
          "profile": "paid"
        },
        {
          "component": "ourapps-ae/realtime-rooms",
          "profile": "own-hardware"
        }
      ]
    },
    {
      "id": "video",
      "candidates": [
        {
          "component": "ourapps-ae/video-calls",
          "profile": "free"
        },
        {
          "component": "ourapps-ae/video-calls",
          "profile": "paid"
        },
        {
          "component": "ourapps-ae/video-calls",
          "profile": "scale"
        }
      ]
    }
  ],
  "scale": {
    "question": "scale",
    "bands": [
      {
        "id": "small",
        "label": "small: fewer than 10 people, occasional use",
        "load": {
          "concurrentPeople": 10,
          "requestsPerDay": 2000,
          "storedMegabytes": 100
        }
      },
      {
        "id": "medium",
        "label": "medium: up to 100 people, daily use",
        "load": {
          "concurrentPeople": 100,
          "requestsPerDay": 50000,
          "storedMegabytes": 1000
        }
      },
      {
        "id": "large",
        "label": "large: 100 or more people, continuous use",
        "load": {
          "concurrentPeople": 1000,
          "requestsPerDay": 1000000,
          "storedMegabytes": 10000
        }
      }
    ]
  },
  "questions": [
    {
      "id": "targets",
      "ask": "Which devices should the game run on?",
      "askAgent": "Infer from the request (phone, tablet, television, computer, browser); ask only if no device is named.",
      "type": "set",
      "options": [
        "web",
        "ios",
        "android",
        "macos",
        "windows",
        "tvos"
      ],
      "default": [
        "web",
        "ios",
        "android",
        "macos",
        "windows",
        "tvos"
      ],
      "effects": [
        {
          "sets": {
            "ourapps-release.targets": "$answer",
            "apple-host.targets": "$answer"
          }
        }
      ]
    },
    {
      "id": "webAddress",
      "ask": "At which web address will the web version be served?",
      "askAgent": "Ask only when the web is a target; keep http://localhost:5173 for local use, otherwise the developer's own https address.",
      "askWhen": {
        "question": "targets",
        "contains": "web"
      },
      "type": "text",
      "default": "http://localhost:5173",
      "effects": [
        {
          "sets": {
            "web-host.webAddress": "$answer",
            "application.webAddress": "$answer",
            "server-host.allowedOrigins": "$answer",
            "invitations.inviteAddress": "$answer"
          }
        }
      ]
    },
    {
      "id": "bundleId",
      "ask": "Which bundle identifier should the phone, tablet, television and Mac apps carry (for example com.yourname.poker)? Leave empty to use the one the application derives.",
      "askAgent": "Leave empty unless the developer names one; the application derives app.ourapps.<applicationId>.",
      "type": "text",
      "default": "",
      "effects": [
        {
          "sets": {
            "apple-host.bundleIdentifier": "$answer",
            "android-host.packageId": "$answer",
            "ourapps-release.bundleIdentifier": "$answer",
            "application.packageId": "$answer"
          }
        }
      ]
    },
    {
      "id": "scale",
      "ask": "How many people will use it, and how often?",
      "askAgent": "Choose from the group size and rhythm described: a dozen friends meeting weekly is small; a club or a few dozen people playing daily is medium; 100 or more people playing continuously is large.",
      "type": "choice",
      "options": [
        "small",
        "medium",
        "large"
      ],
      "default": "small",
      "effects": []
    },
    {
      "id": "languages",
      "ask": "Which languages should the game speak?",
      "askAgent": "Use the languages the request names; otherwise keep all four.",
      "type": "set",
      "options": [
        "en",
        "fr",
        "de",
        "es"
      ],
      "default": [
        "en",
        "fr",
        "de",
        "es"
      ],
      "effects": [
        {
          "sets": {
            "translations.languages": "$answer"
          }
        }
      ]
    },
    {
      "id": "look",
      "ask": "Which look should the game have?",
      "askAgent": "Pick night (dark) or lounge (warm) from any style the request gives; otherwise keep night.",
      "type": "choice",
      "options": [
        "night",
        "lounge"
      ],
      "default": "night",
      "effects": [
        {
          "sets": {
            "theme.themeName": "$answer",
            "card-graphics.backStyle": {
              "map": {
                "night": "stripes",
                "lounge": "plain"
              }
            }
          }
        }
      ]
    },
    {
      "id": "players",
      "ask": "What is the largest number of players at one table (2 to 9)?",
      "askAgent": "Use the largest group that will sit together; keep 9 if unstated.",
      "type": "integer",
      "min": 2,
      "max": 9,
      "default": 9,
      "effects": [
        {
          "sets": {
            "seating.maximumPlayers": "$answer",
            "holdem-rules.seats": "$answer",
            "chip-ledger.seats": "$answer",
            "room-directory.roomCapacity": "$answer",
            "application.maximumPlayers": "$answer"
          }
        }
      ]
    },
    {
      "id": "startingChips",
      "ask": "How many chips does each player start with?",
      "askAgent": "Use the number in the request; keep 5000 if unstated.",
      "type": "integer",
      "min": 100,
      "max": 1000000,
      "default": 5000,
      "effects": [
        {
          "sets": {
            "tournament.startingStack": "$answer",
            "tournament.rebuyStack": "$answer",
            "application.startingStack": "$answer"
          }
        }
      ]
    },
    {
      "id": "levelSeconds",
      "ask": "How many seconds does each blind level last?",
      "askAgent": "Convert minutes to seconds; keep 600 (10 minutes) if unstated.",
      "type": "integer",
      "min": 60,
      "max": 3600,
      "default": 600,
      "effects": [
        {
          "sets": {
            "level-schedule.levelSeconds": "$answer",
            "application.levelSeconds": "$answer"
          }
        }
      ]
    },
    {
      "id": "rebuys",
      "ask": "How many rebuys may each player take (0 for none)?",
      "askAgent": "Use 0 if the request says no rebuys; keep 1 (until level 3) if unstated.",
      "type": "integer",
      "min": 0,
      "max": 5,
      "default": 1,
      "effects": [
        {
          "sets": {
            "tournament.rebuysPerPlayer": "$answer",
            "application.rebuysPerPlayer": "$answer"
          }
        }
      ]
    },
    {
      "id": "decisionSeconds",
      "ask": "How many seconds does a player have to act before the game checks or folds for them?",
      "askAgent": "Keep 30 unless the request names a pace.",
      "type": "integer",
      "min": 5,
      "max": 300,
      "default": 30,
      "effects": [
        {
          "sets": {
            "game-clock.decisionSeconds": "$answer",
            "turn-engine.decisionSeconds": "$answer",
            "application.decisionSeconds": "$answer"
          }
        }
      ]
    },
    {
      "id": "computerPlayers",
      "ask": "Should computer players be available? none: never; on-request: a person adds one and one plays for someone who is away; fill-empty: also fills every empty seat when the game starts.",
      "askAgent": "on-request unless the request says people only (none) or asks for full tables (fill-empty).",
      "type": "choice",
      "options": [
        "none",
        "on-request",
        "fill-empty"
      ],
      "default": "on-request",
      "effects": [
        {
          "sets": {
            "computer-players.mode": "$answer",
            "application.computerPlayers": "$answer"
          }
        }
      ]
    },
    {
      "id": "video",
      "ask": "Should players see and hear each other by video?",
      "askAgent": "No if the request says no video or the people share a room; when yes the developer supplies the video service address and the key and secret by reference.",
      "type": "boolean",
      "default": true,
      "effects": []
    },
    {
      "id": "videoServiceUrl",
      "ask": "What is the web address of your LiveKit video service (leave empty to set it later)?",
      "askAgent": "Ask only when video is on; the developer's own LiveKit address, never invented.",
      "askWhen": {
        "question": "video",
        "equals": true
      },
      "type": "text",
      "default": "",
      "effects": [
        {
          "sets": {
            "video-calls.serviceUrl": "$answer"
          }
        }
      ]
    },
    {
      "id": "videoKey",
      "ask": "Under which name is the video service API key kept in your secret store?",
      "askAgent": "Ask only when video is on; a reference name, never the key.",
      "askWhen": {
        "question": "video",
        "equals": true
      },
      "type": "secretRef",
      "effects": [
        {
          "sets": {
            "video-calls.keyReference": {
              "ref": "videoKey"
            }
          }
        }
      ]
    },
    {
      "id": "videoSecret",
      "ask": "Under which name is the video service API secret kept in your secret store?",
      "askAgent": "Ask only when video is on; a reference name, never the secret.",
      "askWhen": {
        "question": "video",
        "equals": true
      },
      "type": "secretRef",
      "effects": [
        {
          "sets": {
            "video-calls.secretReference": {
              "ref": "videoSecret"
            }
          }
        }
      ]
    },
    {
      "id": "lessons",
      "ask": "Should the game teach new players with step-by-step lessons?",
      "askAgent": "Yes unless the request says players already know the game.",
      "type": "boolean",
      "default": true,
      "effects": []
    },
    {
      "id": "server",
      "ask": "Where should the server run: on a hosting provider (Cloudflare) or on your own hardware?",
      "askAgent": "Ask the developer; never guess a hosting account. cloudflare needs the developer's Cloudflare account; own-hardware needs a machine. The cost and size of the choice are picked from the scale answer.",
      "type": "choice",
      "options": [
        "cloudflare",
        "own-hardware"
      ],
      "effects": []
    },
    {
      "id": "hostingAccount",
      "ask": "Under which name is your Cloudflare account kept in your secret store?",
      "askAgent": "Ask only for a hosting provider; a reference name (lowercase letters, digits, hyphens), never the account key.",
      "askWhen": {
        "question": "server",
        "in": [
          "cloudflare"
        ]
      },
      "type": "secretRef",
      "effects": [
        {
          "sets": {
            "server-host.accountReference": {
              "ref": "hostingAccount"
            }
          }
        }
      ]
    },
    {
      "id": "updates",
      "ask": "Should installed apps offer new versions through ourapps.app?",
      "askAgent": "No unless the request mentions updates or keeping the app current.",
      "type": "boolean",
      "default": false,
      "effects": [
        {
          "sets": {
            "application.updatesEnabled": "$answer"
          }
        }
      ]
    },
    {
      "id": "storeInvitation",
      "ask": "What is your ourapps.app store invitation link (leave empty to set it later)?",
      "askAgent": "Ask only when updates are on; the developer's own link, never invented.",
      "askWhen": {
        "question": "updates",
        "equals": true
      },
      "type": "text",
      "default": "",
      "effects": [
        {
          "sets": {
            "store-update.inviteAddress": "$answer",
            "application.inviteAddress": "$answer"
          }
        }
      ]
    },
    {
      "id": "storeCredentials",
      "ask": "Under which name are your app store credentials kept in your secret store?",
      "askAgent": "Ask only when updates are on or iPhone and iPad is a target (the release pipeline has no store call and no iOS job without it); a reference name, never the credentials.",
      "askWhen": {
        "any": [
          {
            "question": "updates",
            "equals": true
          },
          {
            "question": "targets",
            "contains": "ios"
          }
        ]
      },
      "type": "secretRef",
      "effects": [
        {
          "sets": {
            "ourapps-release.storeCredentials": {
              "ref": "storeCredentials"
            }
          }
        }
      ]
    },
    {
      "id": "androidSigning",
      "ask": "Under which name is your Android signing key kept in your secret store?",
      "askAgent": "Ask only when Android is a target; a reference name, never the key.",
      "askWhen": {
        "question": "targets",
        "contains": "android"
      },
      "type": "secretRef",
      "effects": [
        {
          "sets": {
